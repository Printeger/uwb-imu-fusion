devel/
build/
bin/
lib/
msg_gen/
srv_gen/
build_isolated/
devel_isolated/

# CMake/CTest runtime artifacts created when tests are launched from repo root
/Testing/
core
core.*

# Logs & generated analysis (debug log system)
