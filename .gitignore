# Emacs
.#*

# Catkin custom files
CATKIN_IGNORE
data/*.bag
/results/integrity_round3/
# Windows alternate-data-stream metadata copied onto POSIX filesystems.
*:Zone.Identifier

# Wrap-up guard (2026-09-22): keep large or transient artifacts out of the repo.
# The large local dirs (/results/, /logs/, /Testing/) and the evidence scratch
# tree (doc/evidence/integrity-kernel-refactor/raw/) are covered above or by
# nested .gitignore files; these rules guard against new strays.
*.bag
*.orig
*.rej
*.bak
*.tmp
/scratch/

# P1-06 pause checkpoint: large local evidence remains available for resume,
# but is not part of Git transport.  The nested allowlist keeps only compact
# status, summary, identity, hash, command and exit-code records visible.
/docs/evidence/p1-06-position-quality-acceptance/
/docs/evidence/p0-07-corrected-exhaustive/

# User-owned review inputs kept locally for audit/reproduction. These exact
# files are outside the P1-06 pause checkpoint; do not broadly ignore /doc/.
/doc/UWB_IMU_PL_系统审计与复现报告.md
/doc/review/UWB_IMU_FDE_Code_Review_c7fd4cc.md
/doc/review/artifact_validation.json
/doc/review/review_math_oracles.json
/doc/review/review_math_oracles.py

# Local user-provided requirements stay local except the formal SC7 inputs.
# Keep its goal and acceptance criteria alongside the implementation and report.
/docs/requirements/*
!/docs/requirements/sc7/
/docs/requirements/sc7/*
!/docs/requirements/sc7/GOAL_SC7.txt
!/docs/requirements/sc7/SC7_REQUIREMENTS.md

# Full numeric comparison dumps are disposable intermediate evidence.
# Keep executable checks and compact JSON summaries instead.
*.semantics.txt

# Benchmark transport: keep source, configs, compact metrics and report figures.
# Raw datasets, cached arrays, trajectories, binaries and logs stay local.
/cache/
/datasets/
/benchmark/cache/
/benchmark/results/
/benchmark/build/
/benchmark/devel/
/benchmark/install/
/benchmark/logs/

# C++/CMake products, including standalone benchmark builds.
*.o
*.a
*.so
*.so.*
/install/
/install_isolated/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Additional raw sensor recording formats (report PNG/JSON/CSV remain tracked).
*.bag.active
*.db3
*.db3-shm
*.db3-wal
*.mcap

# Local preservation archives and disposable caches. Commit source/history and
# compact summaries instead of duplicating reproducible trees or Git objects.
/*.bundle
/*.tar
/*.tar.gz
/*.tgz
/*.zip
/.cache/
/benchmark/.cache/

# Epoch RAIM / fused-PL / HYBRID research scratch outputs (including TMPDIR=$PWD).
# Keep algorithm sources, configs and compact reports/figures trackable.
/epoch-architecture-*/
/fde-next-*/
/research/output/
/docs/fde_next/raw/
/docs/fde_next/snapshots/
*.matrices

# HYBRID direct-run outputs written to the repository root. The CLI's default
# .cache/hybrid/ directory is already covered by /.cache/ above.
/hybrid-*/
/hybrid*.csv
/hybrid*.json
/hybrid*.xml

# Standalone Gaussian tightening oracle scratch; the CLI uses .cache/hybrid/.
/tightening-*/
# Direct oracle runs with destination '.' emit these full numeric tables.
# Root-only rules keep compact evidence under doc/ and docs/ trackable.
/candidates.csv
/intervals.csv
/audit.csv

# Raw-source / nonlinear inclusion and AL-policy direct-run scratch outputs.
# Default .cache/hybrid-raw/ runs are covered by /.cache/ above. Root-only
# patterns keep implementation, policy YAML and compact docs trackable.
/raw-source-*/
/raw-bound-*/
/raw-source*.csv
/raw-bound*.csv
/application-al*.json

# SC research replay scratch written directly to the repository root.
# Default .cache/sc* outputs are already ignored. Keep source, config and
# compact evidence in docs/ trackable by rooting these patterns here.
/sc2-imu-*/
/sc3-joint-*/
/sc4-system-*/
/sc5-rolling-*/
/sc5-open-*/
/sc6-*/
/sc7-*/
/sc8-*/
/sc[1-8]*.csv
/sc[1-8]*.json
/sc[1-8]*.xml
/sc6*.log

# Open rolling direct-run outputs; default .cache/sc5-open/ is covered above.
/open-rolling-*/
/open-rolling*.csv
/open-rolling*.json
/open-rolling*.xml

# SC8 requirements are permanent experiment contracts, not scratch.
!/docs/requirements/sc8/
!/docs/requirements/sc8/SC8_EXPERIMENT_HANDBOOK.md
!/docs/requirements/sc8/SC8_PLAN.template.yaml
!/docs/requirements/sc8/GOAL_SC8.txt
