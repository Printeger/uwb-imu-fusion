  1041	std::vector<NavState> DataLoader::LoadGroundTruth(const std::string& bag_path) {
  1042	  std::vector<NavState> gt;
  1043	  if (gt_topic_.empty()) {
  1044	    std::cout << "LoadGroundTruth: no vicon topic configured, skipping.\n";
  1045	    return gt;
  1046	  }
  1047	
  1048	  rosbag::Bag bag;
  1049	  try {
  1050	    bag.open(bag_path, rosbag::bagmode::Read);
