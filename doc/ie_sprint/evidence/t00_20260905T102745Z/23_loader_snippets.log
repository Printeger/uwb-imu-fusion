   995	std::vector<NavState> DataLoader::LoadGroundTruthSfuise(
   996	    const std::string& bag_path) {
   997	  std::vector<NavState> gt;
   998	  const std::string& gt_topic = cfg_.sfuise_gt_topic;
   999	  if (gt_topic.empty()) {
  1000	    std::cout << "LoadGroundTruth(SFUISE): no GT topic configured.\n";
  1001	    return gt;
  1002	  }
  1003	
  1004	  rosbag::Bag bag;
  1005	  try {
  1006	    bag.open(bag_path, rosbag::bagmode::Read);
  1007	  } catch (const std::exception& e) {
  1008	    std::cerr << "LoadGroundTruth(SFUISE): cannot open bag: " << e.what()
  1009	              << "\n";
  1010	    return gt;
  1011	  }
  1012	
  1013	  rosbag::View view;
  1014	  view.addQuery(bag, rosbag::TopicQuery({gt_topic}));
  1015	  if (view.size() == 0) {
  1016	    std::cerr << "LoadGroundTruth(SFUISE): no messages on " << gt_topic << "\n";
  1017	    bag.close();
  1018	    return gt;
  1019	  }
  1020	
  1021	  for (const auto& m : view) {
  1022	    auto tf_msg = m.instantiate<geometry_msgs::TransformStamped>();
  1023	    if (!tf_msg) continue;
  1024	    NavState s;
  1025	    s.t = tf_msg->header.stamp.toSec();
  1026	    auto& q = tf_msg->transform.rotation;
  1027	    auto& p = tf_msg->transform.translation;
  1028	    s.T = gtsam::Pose3(gtsam::Rot3::Quaternion(q.w, q.x, q.y, q.z),
  1029	                       gtsam::Point3(p.x, p.y, p.z));
  1030	    s.v = gtsam::Vector3::Zero();
  1031	    s.ba = gtsam::Vector3::Zero();
  1032	    s.bg = gtsam::Vector3::Zero();
  1033	    gt.push_back(s);
  1034	  }
  1035	  bag.close();
  1036	  std::cout << "LoadGroundTruth(SFUISE): " << gt.size() << " GT poses from "
  1037	            << gt_topic << "\n";
  1038	  return gt;
  1039	}
