    19	
    20	gtsam::NonlinearFactorGraph Optimizer::BuildCleanGraph(
    21	    const NonlinearFactorGraph& full, const std::set<size_t>& uwb_set,
    22	    const std::set<size_t>& rejected) const {
    23	  NonlinearFactorGraph clean;
    24	  for (size_t i = 0; i < full.size(); ++i) {
    25	    if (!full.at(i)) continue;
    26	    if (uwb_set.count(i) && rejected.count(i)) continue;
    27	    clean.add(full.at(i));
    28	  }
    29	  return clean;
    30	}
    31	
    32	std::vector<size_t> Optimizer::ChiSquareReject(
    33	    const NonlinearFactorGraph& full, const Values& values,
    34	    const std::set<size_t>& uwb_set,
    35	    const std::set<size_t>& already_rejected) const {
    36	  std::vector<size_t> newly;
    37	  for (size_t i = 0; i < full.size(); ++i) {
    38	    if (!uwb_set.count(i) || already_rejected.count(i)) continue;
    39	    auto f = full.at(i);
    40	    if (!f) continue;
    41	    double chi2 = 2.0 * f->error(values);
    42	    double thresh = Chi2inv(cfg_.chi2_reject_prob, (size_t)f->dim());
    43	    if (chi2 > thresh) {
    44	      newly.push_back(i);
    45	    }
    46	  }
    47	  return newly;
    48	}
    49	
    50	double Optimizer::ReducedChi2(const NonlinearFactorGraph& g,
    51	                              const Values& v) const {
    52	  double chi2 = 2.0 * g.error(v);
    53	  size_t m = 0;
    54	  for (size_t i = 0; i < g.size(); ++i) {
    55	    auto f = g.at(i);
    56	    if (f) m += f->dim();
    57	  }
    58	  size_t n = v.dim();
    59	  size_t nu = (m > n) ? (m - n) : 1;
    60	  return chi2 / static_cast<double>(nu);
    61	}
    62	
    63	OptimizerResult Optimizer::Optimize(const NonlinearFactorGraph& graph,
    64	                                    const Values& initial,
    65	                                    const std::vector<size_t>& uwb_indices) {
    66	  OptimizerResult out;
    67	  std::set<size_t> uwb_set(uwb_indices.begin(), uwb_indices.end());
    68	
    69	  // --- LM params (shared by GNC inner loop and clean refinement) ---
    70	  LevenbergMarquardtParams lm_params;
    71	  lm_params.setMaxIterations(cfg_.lm_max_iter);
    72	  lm_params.setRelativeErrorTol(cfg_.lm_rel_tol);
    73	  lm_params.setAbsoluteErrorTol(cfg_.lm_abs_tol);
    74	  lm_params.setLinearSolverType("SEQUENTIAL_CHOLESKY");  // avoid TBB segfault
    75	
    76	  out.initial_error = graph.error(initial);
    77	  std::cout << "  [Stage 0/3] Pre-warming LM... " << std::flush;
    78	
    79	  // ============ Stage 0: Pre-warming LM (no robust weighting) ============
    80	  // The initial IMU-predicted trajectory can have huge errors (10^9–10^11)
    81	  // with zero-bias initialization. If GNC+TLS with setKnownInliers runs
    82	  // directly on this, the IMU-dominated cost forces all UWB weights to
    83	  // near-zero, causing catastrophic outlier rejection.
    84	  //
    85	  // Standard LM iterations on the full graph reduce the initial error
    86	  // by orders of magnitude, bringing the solution into a regime where GNC
    87	  // can correctly distinguish NLOS outliers from inliers.
    88	  LevenbergMarquardtParams prewarm_params = lm_params;
    89	  int prewarm_iters = (out.initial_error > 1e8)   ? 30
    90	                      : (out.initial_error > 1e4) ? 15
    91	                                                  : 10;
    92	  prewarm_params.setMaxIterations(prewarm_iters);
    93	  Values prewarmed = initial;
    94	  {
    95	    LevenbergMarquardtOptimizer preopt(graph, prewarmed, prewarm_params);
    96	    prewarmed = preopt.optimize();
    97	  }
    98	  std::cout << "done (error " << out.initial_error << " -> "
    99	            << graph.error(prewarmed) << ", " << prewarm_iters << " iters)\n";
   100	  std::cout << "  [Stage 1/3] GNC+TLS annealing... " << std::flush;
   101	
   102	  // ====================== Stage A: GNC + TLS ======================
   103	  // Build known-inliers index vector: all non-UWB factors (IMU preintegration
   104	  // and priors) are pinned as inliers so that GNC's robustness budget is
   105	  // solely spent on identifying UWB NLOS outliers (design doc §15.1.1).
   106	  std::vector<size_t> known_inliers;
   107	  for (size_t i = 0; i < graph.size(); ++i)
   108	    if (!uwb_set.count(i)) known_inliers.push_back(i);
   109	
   110	  GncParams<LevenbergMarquardtParams> gncParams(lm_params);
   111	  gncParams.setLossType(GncLossType::TLS);   // Truncated Least Squares
   112	  gncParams.setKnownInliers(known_inliers);  // pin IMU/priors
   113	  gncParams.setMuStep(cfg_.gnc_mu_step);
   114	  gncParams.setMaxIterations(cfg_.gnc_max_iter);
   115	  gncParams.setRelativeCostTol(cfg_.gnc_rel_cost_tol);
   116	
   117	  GncOptimizer<GncParams<LevenbergMarquardtParams>> gnc(graph, prewarmed,
   118	                                                        gncParams);
   119	  // Auto-set per-factor inlier cost thresholds from chi2 quantile:
   120	  //   barc^2 = 0.5 * chi2inv(gnc_inlier_prob, dim)
   121	  gnc.setInlierCostThresholdsAtProbability(cfg_.gnc_inlier_prob);
   122	  Values gnc_result = gnc.optimize();
   123	  out.gnc_weights = gnc.getWeights();  // size = graph.size(), inliers ~1
   124	
   125	  std::cout << "done (weights [" << out.gnc_weights.minCoeff() << ", "
   126	            << out.gnc_weights.maxCoeff() << "])\n";
   127	  std::cout << "  [Stage 2/3] chi2 rejection + clean LM refine... "
   128	            << std::flush;
   129	
   130	  // --- Hard-reject UWB factors with GNC weight below threshold ---
   131	  std::set<size_t> rejected;
   132	  for (size_t idx : uwb_indices)
   133	    if (out.gnc_weights(idx) < cfg_.gnc_weight_thresh) rejected.insert(idx);
   134	
   135	  // ============ Stage B: Chi-square rejection loop on clean graph ============
   136	  // The clean graph removes GNC-rejected factors; the follow-up chi2 loop
   137	  // catches "grey-zone" outliers (w ~0.3-0.7) that GNC didn't fully reject.
   138	  Values refined = gnc_result;
   139	  int round = 0;
   140	  for (; round < cfg_.max_rejection_rounds; ++round) {
   141	    NonlinearFactorGraph clean = BuildCleanGraph(graph, uwb_set, rejected);
   142	    LevenbergMarquardtOptimizer lmopt(clean, refined, lm_params);
   143	    refined = lmopt.optimize();
   144	
   145	    auto newly = ChiSquareReject(graph, refined, uwb_set, rejected);
   146	    if (newly.empty()) {
   147	      clean_graph_ = clean;
   148	      break;
   149	    }
   150	    rejected.insert(newly.begin(), newly.end());
   151	  }
   152	
   153	  // If max rounds reached, build final clean graph and do one last LM refine
   154	  if (round == cfg_.max_rejection_rounds) {
   155	    clean_graph_ = BuildCleanGraph(graph, uwb_set, rejected);
   156	    LevenbergMarquardtOptimizer lmopt(clean_graph_, refined, lm_params);
   157	    refined = lmopt.optimize();
   158	  }
   159	
   160	  // --- Result assembly ---
   161	  out.values = refined;
   162	  out.reduced_chi2 = ReducedChi2(clean_graph_, refined);
   163	  out.num_rejection_rounds = round;
   164	  out.outlier_uwb_indices.assign(rejected.begin(), rejected.end());
   165	  for (size_t idx : uwb_indices) {
   166	    if (!rejected.count(idx)) out.inlier_uwb_indices.push_back(idx);
   167	  }
   168	  out.final_error = clean_graph_.error(refined);
   169	
   170	  result_values_ = refined;
   171	  solved_ = true;
   172	
   173	  std::cout << "done (chi2=" << out.reduced_chi2
   174	            << ", inliers=" << out.inlier_uwb_indices.size() << "/"
   175	            << uwb_indices.size()
   176	            << ", outliers=" << out.outlier_uwb_indices.size()
   177	            << ", #reject-rounds=" << out.num_rejection_rounds << ")\n";
   178	  return out;
   179	}
