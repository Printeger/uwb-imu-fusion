    23	std::string Logger::Timestamp() {
    24	  auto t = std::time(nullptr);
    25	  auto tm = *std::localtime(&t);
    26	  std::ostringstream ss;
    27	  ss << std::put_time(&tm, "%Y-%m-%d_%H-%M-%S");
    28	  return ss.str();
    29	}
    30	
    31	std::string Logger::Init(const std::string& config_dir,
    32	                         const std::string& bag_path) {
    33	  config_dir_ = config_dir;
    34	
    35	  // Derive a short, human-readable name from the bag filename
    36	  std::string bag_short = fs::path(bag_path).stem().string();
    37	  if (bag_short.size() > 50) bag_short = bag_short.substr(0, 50);
    38	
    39	  log_dir_ = config_dir + "/../logs/" + Timestamp() + "_" + bag_short;
    40	  if (!fs::exists(log_dir_)) {
    41	    fs::create_directories(log_dir_);
    42	  }
    43	  enabled_ = true;
    44	  std::cout << "[Logger] " << log_dir_ << "\n";
    45	  return log_dir_;
    46	}
