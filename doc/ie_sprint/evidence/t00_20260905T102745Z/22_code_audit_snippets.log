   109	// ===========================================================================
   110	// Per-keyframe state trace
   111	// ===========================================================================
   112	void Logger::LogStateTrace(const std::vector<NavState>& traj) {
   113	  if (!enabled_ || traj.empty()) return;
   114	  EnsureOpen();
   115	  if (!state_header_) {
   116	    state_csv_ << "t,x,y,z,qw,qx,qy,qz,vx,vy,vz\n";
   117	    state_header_ = true;
   118	  }
   119	  for (const auto& s : traj) {
   120	    auto p = s.T.translation();
   121	    auto q = s.T.rotation().toQuaternion();
   122	    state_csv_ << std::fixed << std::setprecision(6) << s.t << "," << p.x()
   123	               << "," << p.y() << "," << p.z() << "," << q.w() << "," << q.x()
   124	               << "," << q.y() << "," << q.z() << "," << s.v.x() << ","
   125	               << s.v.y() << "," << s.v.z() << "\n";
   126	  }
   127	  state_csv_.flush();
   128	}
