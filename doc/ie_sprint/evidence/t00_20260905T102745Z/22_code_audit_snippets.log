    76	        a.id = i + 1;
    77	        a.pos = Eigen::Vector3d(R * cos(2 * M_PI * i / N_),
    78	                                R * sin(2 * M_PI * i / N_), 1.8);
    79	        anchors_.push_back(a);
    80	      }
    81	    }
    82	    ROS_INFO("UwbTwrSim: total anchors = %d", (int)anchors_.size());
    83	
    84	    // Auto-align superframe to pub rate: T_sf = 1/pub_rate ensures every
    85	    // publish captures a complete TDMA cycle with all N anchors ranged.
    86	    double T_sf_user = T_sf_;
    87	    if (pub_rate_ > 0) {
    88	      T_sf_ = 1.0 / pub_rate_;  // one full superframe per publish interval
    89	    }
    90	    tau_ = T_sf_ / N_;
    91	    int m = (mode_str_ == "DS") ? 3 : 2;
    92	    double t_msg;
    93	    nh_.param("msg_air_time", t_msg, 0.0015);
    94	    kmax_ = std::max(1, (int)(tau_ / (m * t_msg)));
    95	    c_ss_ = 2.0;
    96	    c_ds_ = 0.05;
    97	
    98	    // Per-link biases
    99	    blink_.resize(N_, std::vector<double>(N_, 0));
   100	    std::uniform_real_distribution<double> ub(-bmax_, bmax_);
   101	    for (int i = 0; i < N_; ++i)
   102	      for (int j = 0; j < N_; ++j)
   103	        if (i != j) blink_[i][j] = ub(rng_);
   104	
   105	    clk_.resize(N_, 0);
   106	    nlos_exp_ = std::exponential_distribution<double>(1.0 / nlos_mean_);
   107	
   108	    std::string odom_topic;
   109	    nh_.param("odom_topic", odom_topic, std::string("/sim/odom"));
   110	    odom_sub_ = nh_.subscribe(odom_topic, 10, &UwbTwrSim::odomCb, this);
   111	    pub_ = nh_.advertise<uwb_imu_fgo::LinktrackNodeframe3>(
   112	        "/nlink_linktrack_nodeframe3", 10);
   113	    viz_anchor_pub_ = nh_.advertise<visualization_msgs::Marker>(
   114	        "/uwb_sim/anchor_markers", 100, true);  // high queue, latched
   115	    viz_line_pub_ =
   116	        nh_.advertise<visualization_msgs::Marker>("/uwb_sim/range_lines", 100);
   117	    timer_ = nh_.createTimer(ros::Duration(tau_), &UwbTwrSim::onSlot, this);
   118	    pub_timer_ = nh_.createTimer(ros::Duration(1.0 / pub_rate_),
   119	                                 &UwbTwrSim::onPublish, this);
   120	    viz_timer_ = nh_.createTimer(ros::Duration(0.1), &UwbTwrSim::onViz, this);
   121	
   122	    publishAnchorMarkers();
   123	    double slots_per_pub = (1.0 / pub_rate_) / tau_;
   124	    int est_anchors_per_msg = (int)(slots_per_pub * kmax_);
   125	    ROS_INFO(
   126	        "UwbTwrSim: %d anchors, T_sf=%.3fs (auto-align to pub_rate=%.1f Hz), "
   127	        "tau=%.4fs, kmax=%d → ~%d ranges/msg",
   128	        N_, T_sf_, pub_rate_, tau_, kmax_, est_anchors_per_msg);
   129	  }
   130	
   131	 private:
   132	  struct Anchor {
   133	    int id;
   134	    Eigen::Vector3d pos;
   135	  };
   136	  struct Drone {
   137	    Eigen::Vector3d p;
   138	    ros::Time t;
   139	    bool ok = false;
   140	  };
   141	
   142	  void odomCb(const nav_msgs::Odometry::ConstPtr& m) {
   143	    drone_.p = {m->pose.pose.position.x, m->pose.pose.position.y,
   144	                m->pose.pose.position.z};
   145	    drone_.t = m->header.stamp;
   146	    drone_.ok = true;
   147	  }
   148	
   149	  void onSlot(const ros::TimerEvent&) {
   150	    int i = slot_;
   151	    ros::Time now = ros::Time::now();
   152	    clk_[i] += ppm_ * 1e-6 * tau_;
   153	    if (!drone_.ok || (now - drone_.t).toSec() > odom_to_) {
   154	      slot_ = (slot_ + 1) % N_;
   155	      return;
   156	    }
   157	
   158	    int cnt = 0;
   159	    for (int off = 0; off < N_ && cnt < kmax_; ++off) {
   160	      int j = (i + off) % N_;
   161	      double d = (drone_.p - anchors_[j].pos).norm();
   162	      if (d > max_range_) continue;
   163	      if (uni_(rng_) < ploss_) continue;
   164	
   165	      bool nlos = uni_(rng_) < nlos_p_;
   166	      last_ranges_[anchors_[j].id] = {anchors_[j].pos, d, nlos};
   167	      double eps = (mode_str_ == "DS") ? (clk_[i] - clk_[j]) * c_ds_
   168	                                       : (clk_[i] - clk_[j]) * c_ss_;
   169	      double dd = d * (1.0 + eps) + b0_ + blink_[i][j];
   170	      if (nlos) dd += nlos_exp_(rng_);
   171	      dd += gauss_(rng_) * sigma_;
   172	
   173	      uwb_imu_fgo::LinktrackNode2 nd;
   174	      nd.role = 1;
   175	      nd.id = anchors_[j].id;
   176	      nd.dis = (float)std::max(0.0, dd);
   177	      double dist = std::max(d, 0.1);
   178	      nd.rx_rssi = (float)(P_tx_ - 10 * n_p_ * log10(dist / d0_) +
   179	                           shadow_(rng_) * s_sh_);
   180	      nd.fp_rssi = nd.rx_rssi - (float)(nlos ? (fp_lo_ + fp_nl_) : fp_lo_);
   181	      pending_map_[anchors_[j].id] = nd;  // dedup: keep latest per anchor
   182	      ++cnt;
   183	    }
   184	    slot_ = (slot_ + 1) % N_;
   185	  }
   186	
   187	  void onPublish(const ros::TimerEvent&) {
   188	    if (pending_map_.empty()) return;
   189	
   190	    uwb_imu_fgo::LinktrackNodeframe3 f;
   191	    ros::Time now = ros::Time::now();
   192	    f.header.stamp = now;
   193	    f.id = tag_id_;
   194	    f.role = 0;
   195	    f.local_time = (uint64_t)(now.toSec() * 1e6);
   196	    f.system_time = (uint32_t)(now.toSec() * 1e3);
   197	    f.voltage = batt_v_;
   198	
   199	    for (auto& kv : pending_map_) {
   200	      f.nodes.push_back(kv.second);
   201	    }
   202	    pub_.publish(f);
   203	    pending_map_.clear();
   204	  }
   205	
   206	  void publishAnchorMarkers() {
   207	    for (const auto& a : anchors_) {
   208	      visualization_msgs::Marker m;
   209	      m.header.frame_id = "world";
   210	      m.header.stamp = ros::Time::now();
