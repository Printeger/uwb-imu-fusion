     9	// Helper: build range expression rho = ||antenna - (anchor_nominal + dA[opt])||
    10	static Double_ BuildRange(const Point3_& antenna, const Point3& A_nom,
    11	                          bool calib_anchor, Key anchor_key) {
    12	  if (calib_anchor) {
    13	    auto f = [A_nom](const Point3& ant, const Point3& dA,
    14	                     OptionalJacobian<1,3> Ha, OptionalJacobian<1,3> Hd) -> double {
    15	      Vector3 d = ant - (A_nom + dA);
    16	      double n = d.norm();
    17	      if (n > 1e-9) { if(Ha) *Ha = d.transpose()/n; if(Hd) *Hd = -d.transpose()/n; }
    18	      else { if(Ha) *Ha = Matrix13::Zero(); if(Hd) *Hd = Matrix13::Zero(); }
    19	      return n;
    20	    };
    21	    return Double_(f, antenna, Point3_(anchor_key));
    22	  } else {
    23	    auto f = [A_nom](const Point3& ant, OptionalJacobian<1,3> H) -> double {
    24	      Vector3 d = ant - A_nom;
    25	      double n = d.norm();
    26	      if (n > 1e-9) { if(H) *H = d.transpose()/n; } else { if(H) *H = Matrix13::Zero(); }
    27	      return n;
    28	    };
    29	    return Double_(f, antenna);
    30	  }
    31	}
    32	
    33	NonlinearFactor::shared_ptr MakeUwbFactor(
    34	    Key pose_key, Key lever_key, Key anchor_key, Key bias_key,
    35	    const Point3& anchor_nominal, const Point3& lever_init,
    36	    double measured_range, double sigma,
    37	    bool calib_lever, bool calib_anchor, bool calib_bias) {
    38	
    39	  Pose3_  pose_(pose_key);
    40	  Point3_ lever_   = calib_lever ? Point3_(lever_key) : Point3_(lever_init);
    41	  Point3_ antenna_ = transformFrom(pose_, lever_);
    42	
    43	  Double_ rho = BuildRange(antenna_, anchor_nominal, calib_anchor, anchor_key);
    44	
    45	  Double_ predicted = calib_bias ? (rho + Double_(bias_key)) : rho;
    46	
    47	  auto noise = noiseModel::Isotropic::Sigma(1, sigma);
    48	  return boost::make_shared<ExpressionFactor<double>>(noise, measured_range, predicted);
    49	}
