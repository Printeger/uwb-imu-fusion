   159	ATEStats TrajectoryIO::ComputeATE(const std::vector<NavState>& est,
   160	                                  const std::vector<NavState>& gt) {
   161	  ATEStats stats;
   162	  if (est.empty() || gt.empty()) return stats;
   163	
   164	  // --- Match timestamps and collect position pairs ---
   165	  std::vector<Eigen::Vector3d> est_pts, gt_pts;
   166	  std::vector<size_t> est_idx;  // track which est frames were matched
   167	  est_pts.reserve(est.size());
   168	  gt_pts.reserve(est.size());
   169	  est_idx.reserve(est.size());
   170	
   171	  for (size_t i = 0; i < est.size(); ++i) {
   172	    double t = est[i].t;
   173	    auto it = std::lower_bound(
   174	        gt.begin(), gt.end(), t,
   175	        [](const NavState& g, double tval) { return g.t < tval; });
   176	    if (it == gt.end()) continue;
   177	    const NavState* g = nullptr;
   178	    if (it == gt.begin()) {
   179	      g = &(*it);
   180	    } else {
   181	      double d1 = it->t - t;
   182	      double d0 = t - (it - 1)->t;
   183	      g = (d0 < d1) ? &(*(it - 1)) : &(*it);
   184	    }
   185	    est_pts.push_back(Eigen::Vector3d(est[i].T.translation().x(),
   186	                                      est[i].T.translation().y(),
   187	                                      est[i].T.translation().z()));
   188	    gt_pts.push_back(Eigen::Vector3d(g->T.translation().x(),
   189	                                     g->T.translation().y(),
   190	                                     g->T.translation().z()));
   191	    est_idx.push_back(i);
   192	  }
   193	
   194	  if (est_pts.size() < 3) {
   195	    std::cerr << "ComputeATE: too few matched poses (" << est_pts.size()
   196	              << ") for alignment.\n";
   197	    return stats;
   198	  }
   199	
   200	  // --- SE(3) Umeyama alignment ---
   201	  Eigen::Matrix3d R_align;
   202	  Eigen::Vector3d t_align;
   203	  double scale;
   204	  if (!AlignSE3(est_pts, gt_pts, &R_align, &t_align, &scale)) {
   205	    std::cerr << "ComputeATE: SE(3) alignment failed.\n";
   206	    return stats;
   207	  }
   208	
   209	  stats.scale = scale;
   210	  stats.T_align = gtsam::Pose3(gtsam::Rot3(R_align), gtsam::Point3(t_align));
   211	  stats.matched = est_pts.size();
   212	
   213	  // --- Compute aligned errors ---
   214	  std::vector<double> errors;
   215	  errors.reserve(est_pts.size());
   216	  double sum_err = 0.0, sum_err2 = 0.0;
   217	  for (size_t i = 0; i < est_pts.size(); ++i) {
   218	    Eigen::Vector3d aligned = scale * R_align * est_pts[i] + t_align;
   219	    double err = (aligned - gt_pts[i]).norm();
   220	    errors.push_back(err);
   221	    sum_err += err;
   222	    sum_err2 += err * err;
   223	  }
   224	
   225	  std::sort(errors.begin(), errors.end());
   226	  size_t n = errors.size();
   227	  stats.rmse = std::sqrt(sum_err2 / n);
   228	  stats.mean_err = sum_err / n;
   229	  stats.p50 = errors[n * 50 / 100];
   230	  stats.p95 = errors[n * 95 / 100];
   231	  stats.p99 = errors[n * 99 / 100];
   232	  stats.max_err = errors.back();
   233	  stats.ok = true;
   234	  return stats;
   235	}
   236	
   237	double TrajectoryIO::ComputeRPE(const std::vector<NavState>& est,
   238	                                const std::vector<NavState>& gt,
   239	                                double segment_duration) {
   240	  if (est.size() < 2 || gt.size() < 2) return -1.0;
   241	  double sum_err2 = 0.0;
   242	  size_t count = 0;
   243	  for (size_t i = 0; i + 1 < est.size(); ++i) {
   244	    double dt = est[i + 1].t - est[i].t;
   245	    if (std::abs(dt - segment_duration) > 0.5 * segment_duration) continue;
   246	    auto it_i =
   247	        std::lower_bound(gt.begin(), gt.end(), est[i].t,
   248	                         [](const NavState& g, double t) { return g.t < t; });
   249	    auto it_j =
   250	        std::lower_bound(gt.begin(), gt.end(), est[i + 1].t,
   251	                         [](const NavState& g, double t) { return g.t < t; });
   252	    if (it_i == gt.end() || it_j == gt.end()) continue;
   253	    gtsam::Vector3 d_est = gtsam::Vector3(est[i + 1].T.translation()) -
   254	                           gtsam::Vector3(est[i].T.translation());
   255	    gtsam::Vector3 d_gt = gtsam::Vector3(it_j->T.translation()) -
   256	                          gtsam::Vector3(it_i->T.translation());
   257	    gtsam::Vector3 err = d_est - d_gt;
   258	    sum_err2 += err.dot(err);
   259	    ++count;
   260	  }
   261	  return (count > 0) ? std::sqrt(sum_err2 / count) : -1.0;
   262	}
