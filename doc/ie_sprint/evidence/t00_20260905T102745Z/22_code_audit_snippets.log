    56	  f << "anchors:\n";
    57	  for (const auto& a : cfg.anchors) {
    58	    f << "  - {id: " << a.id << ", pos: [" << a.pos.x() << ", " << a.pos.y()
    59	      << ", " << a.pos.z() << "], prior_sigma: " << a.prior_sigma << "}\n";
    60	  }
    61	  f << "\ncalib_lever: " << cfg.calib_lever << "\n";
    62	  f << "calib_anchor: " << cfg.calib_anchor << "\n";
    63	  f << "calib_range_bias: " << cfg.calib_range_bias << "\n";
    64	  f << "lever_prior_sigma: " << cfg.lever_prior_sigma << "\n";
    65	  f << "sigma_range: " << cfg.sigma_range << "\n";
    66	  f << "gnc_mu_step: " << cfg.gnc_mu_step << "\n";
    67	  f << "gnc_max_iter: " << cfg.gnc_max_iter << "\n";
    68	  f << "gnc_inlier_prob: " << cfg.gnc_inlier_prob << "\n";
    69	  f << "gnc_weight_thresh: " << cfg.gnc_weight_thresh << "\n";
    70	  f << "chi2_reject_prob: " << cfg.chi2_reject_prob << "\n";
    71	  f << "max_rejection_rounds: " << cfg.max_rejection_rounds << "\n";
    72	  f << "kf_step: " << cfg.kf_step << "\n";
    73	  f << "lm_max_iter: " << cfg.lm_max_iter << "\n";
    74	  f << "use_imu_orientation_init: " << cfg.use_imu_orientation_init << "\n";
    75	  f << "imu_orientation_world: " << cfg.imu_orientation_world << "\n";
    76	  f << "bag_path: " << cfg.bag_path << "\n";
    77	  f << "dataset_interface: " << cfg.data_interface << "\n";
    78	  if (cfg.data_interface == "mcd") {
    79	    f << "imu_bag_path: " << cfg.imu_bag_path << "\n";
    80	    f << "uwb_bag_path: " << cfg.uwb_bag_path << "\n";
    81	    f << "gt_csv_path: " << cfg.gt_csv_path << "\n";
    82	  }
    83	  f.close();
    84	}
