   130	// ===========================================================================
   131	// Per-anchor per-keyframe residuals
   132	// ===========================================================================
   133	void Logger::LogResiduals(const std::vector<NavState>& traj,
   134	                          const std::vector<UwbFrame>& filtered_uwb,
   135	                          const std::vector<AnchorConfig>& anchors) {
   136	  if (!enabled_ || traj.empty()) return;
   137	  EnsureOpen();
   138	  if (!resid_header_) {
   139	    resid_csv_ << "kf_idx,t";
   140	    for (const auto& a : anchors)
   141	      resid_csv_ << ",resid_a" << a.id << ",n_a" << a.id;
   142	    resid_csv_ << "\n";
   143	    resid_header_ = true;
   144	  }
   145	  for (size_t i = 0; i < traj.size() && i < filtered_uwb.size(); ++i) {
   146	    resid_csv_ << i << "," << std::fixed << std::setprecision(6) << traj[i].t;
   147	    for (const auto& a : anchors) {
   148	      double sum_r2 = 0.0;
   149	      int count = 0;
   150	      for (const auto& r : filtered_uwb[i].ranges) {
   151	        if (r.anchor_id != a.id) continue;
   152	        double pred = (Eigen::Vector3d(traj[i].T.translation()) -
   153	                       Eigen::Vector3d(a.pos.x(), a.pos.y(), a.pos.z()))
   154	                          .norm();
   155	        double res = pred - r.dist;
   156	        sum_r2 += res * res;
   157	        ++count;
   158	      }
   159	      double rmse = (count > 0) ? std::sqrt(sum_r2 / count) : -1.0;
   160	      resid_csv_ << "," << rmse << "," << count;
   161	    }
   162	    resid_csv_ << "\n";
   163	  }
   164	  resid_csv_.flush();
