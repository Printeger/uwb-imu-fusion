    86	// ===========================================================================
    87	// Per-pass optimization metrics
    88	// ===========================================================================
    89	void Logger::LogPass(const std::string& pass_name,
    90	                     const OptimizerResult& result, double elapsed_sec,
    91	                     size_t n_factors, size_t n_uwb) {
    92	  if (!enabled_) return;
    93	  EnsureOpen();
    94	  if (!opt_header_) {
    95	    opt_csv_
    96	        << "pass,initial_error,final_error,reduced_chi2,"
    97	        << "inliers,outliers,n_factors,n_uwb,elapsed_sec,num_reject_rounds\n";
    98	    opt_header_ = true;
    99	  }
   100	  opt_csv_ << "\"" << pass_name << "\"," << result.initial_error << ","
   101	           << result.final_error << "," << result.reduced_chi2 << ","
   102	           << result.inlier_uwb_indices.size() << ","
   103	           << result.outlier_uwb_indices.size() << "," << n_factors << ","
   104	           << n_uwb << "," << elapsed_sec << "," << result.num_rejection_rounds
   105	           << "\n";
   106	  opt_csv_.flush();
   107	}
