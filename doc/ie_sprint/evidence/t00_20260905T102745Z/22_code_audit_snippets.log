    23	GraphBuilder::GraphBuilder(const Config& cfg)
    24	    : cfg_(cfg), anchors_(cfg.anchors) {}
    25	
    26	gtsam::Key GraphBuilder::lever_key() const { return L(0); }
    27	gtsam::Key GraphBuilder::anchor_key(int m) const { return A(m); }
    28	gtsam::Key GraphBuilder::bias_key(int m) const { return Z(m); }
    29	
    30	double GraphBuilder::AdaptiveSigma(double dt_since_last) const {
    31	  double extra = (dt_since_last > 0) ? (cfg_.v_max * dt_since_last / 3.0) : 0.0;
    32	  return std::sqrt(cfg_.sigma_range * cfg_.sigma_range + extra * extra);
    33	}
    34	
    35	void GraphBuilder::AddUwbFactorsForFrame(size_t kf_idx, const UwbFrame& frame,
    36	                                         NonlinearFactorGraph* graph,
    37	                                         std::vector<size_t>* uwb_indices,
    38	                                         Values* values, bool first_frame) {
    39	  for (const UwbRange& r : frame.ranges) {
    40	    int m = r.anchor_id;
    41	
    42	    // Lookup nominal anchor position
    43	    auto it = std::find_if(anchors_.begin(), anchors_.end(),
    44	                           [m](const AnchorConfig& a) { return a.id == m; });
    45	    if (it == anchors_.end()) {
    46	      std::cerr << "Warning: unknown anchor " << m << " in frame kf=" << kf_idx
    47	                << "\n";
    48	      continue;
    49	    }
    50	    const Point3& A_m = it->pos;
    51	
    52	    // Time-adaptive sigma
    53	    double dt_last = 0.0;
    54	    auto tit = last_anchor_time_.find(m);
    55	    if (tit != last_anchor_time_.end()) {
    56	      dt_last = frame.t - tit->second;
    57	    }
    58	    double sigma = AdaptiveSigma(dt_last);
    59	    last_anchor_time_[m] = frame.t;
    60	
    61	    auto factor =
    62	        MakeUwbFactor(X(kf_idx), lever_key(), anchor_key(m), bias_key(m), A_m,
    63	                      cfg_.lever_arm_init, r.dist, sigma, cfg_.calib_lever,
    64	                      cfg_.calib_anchor, cfg_.calib_range_bias);
    65	
    66	    size_t idx = graph->size();
    67	    graph->add(factor);
    68	    uwb_indices->push_back(idx);
    69	  }
    70	}
    71	
    72	void GraphBuilder::Build(const std::vector<UwbFrame>& uwb_kf,
    73	                         const std::vector<ImuSample>& imu,
    74	                         const InitResult& init, NonlinearFactorGraph* graph,
    75	                         Values* values, std::vector<size_t>* uwb_indices) {
    76	  const size_t N = uwb_kf.size();
    77	  if (N < 2) {
    78	    std::cerr << "GraphBuilder: need >= 2 keyframes, got " << N << "\n";
    79	    return;
    80	  }
    81	
    82	  graph->resize(0);
    83	  values->clear();
    84	  uwb_indices->clear();
    85	  last_anchor_time_.clear();
    86	
    87	  // Bias vector
    88	  const imuBias::ConstantBias bias0(init.ba0, init.bg0);
    89	
    90	  // --- Step 1: First keyframe priors + initial Values ---
    91	  auto posePriorNoise = noiseModel::Diagonal::Sigmas(
    92	      (Vector(6) << 0.01, 0.01, 0.01, 0.05, 0.05, 0.05).finished());
    93	  auto velPriorNoise = noiseModel::Isotropic::Sigma(3, 0.1);
    94	  auto biasPriorNoise = noiseModel::Isotropic::Sigma(6, 0.01);
    95	
    96	  graph->addPrior(X(0), init.T0, posePriorNoise);
    97	  graph->addPrior(V(0), init.v0, velPriorNoise);
    98	  graph->addPrior(B(0), bias0, biasPriorNoise);
    99	
   100	  values->insert(X(0), init.T0);
   101	  values->insert(V(0), init.v0);
   102	  values->insert(B(0), bias0);
   103	
   104	  // --- Step 2: Calibration variables + loose priors ---
   105	  if (cfg_.calib_lever) {
   106	    values->insert(lever_key(), cfg_.lever_arm_init);
   107	    graph->addPrior(lever_key(), cfg_.lever_arm_init,
   108	                    noiseModel::Isotropic::Sigma(3, cfg_.lever_prior_sigma));
   109	  }
   110	  for (const auto& a : anchors_) {
   111	    if (cfg_.calib_anchor) {
   112	      values->insert(anchor_key(a.id), Point3(0, 0, 0));
   113	      graph->addPrior(anchor_key(a.id), Point3(0, 0, 0),
   114	                      noiseModel::Isotropic::Sigma(3, a.prior_sigma));
   115	    }
   116	    if (cfg_.calib_range_bias) {
   117	      values->insert<double>(bias_key(a.id), 0.0);
   118	      graph->addPrior<double>(
   119	          bias_key(a.id), 0.0,
   120	          noiseModel::Isotropic::Sigma(1, cfg_.range_bias_sigma));
   121	    }
   122	  }
   123	
   124	  // --- Step 3: UWB factors for first frame ---
   125	  AddUwbFactorsForFrame(0, uwb_kf[0], graph, uwb_indices, values, true);
   126	
   127	  // --- Step 4: Loop keyframes ---
   128	  ImuPreintegrator pim(cfg_, init.gravity_world);
   129	  size_t i_imu = 0;
   130	  while (i_imu < imu.size() && imu[i_imu].t <= uwb_kf[0].t) ++i_imu;
   131	
   132	  Pose3 prev_pose = init.T0;
   133	  Vector3 prev_vel = init.v0;
   134	  imuBias::ConstantBias prev_bias = bias0;
   135	
   136	  for (size_t k = 1; k < N; ++k) {
   137	    // --- 4a: IMU preintegration ---
   138	    pim.Reset(prev_bias);
   139	    i_imu = IntegrateBetween(imu, i_imu, uwb_kf[k - 1].t, uwb_kf[k].t, &pim);
   140	
   141	    // --- 4b: CombinedImuFactor ---
   142	    graph->add(CombinedImuFactor(X(k - 1), V(k - 1), X(k), V(k), B(k - 1), B(k),
   143	                                 pim.Pim()));
   144	
   145	    // --- 4c: Predict initial values ---
   146	    gtsam::NavState pred =
   147	        pim.Pim().predict(gtsam::NavState(prev_pose, prev_vel), prev_bias);
   148	    values->insert(X(k), pred.pose());
   149	    values->insert(V(k), pred.velocity());
   150	    values->insert(B(k), prev_bias);
   151	
   152	    // --- 4d: UWB factors ---
   153	    AddUwbFactorsForFrame(k, uwb_kf[k], graph, uwb_indices, values, false);
   154	
   155	    prev_pose = pred.pose();
   156	    prev_vel = pred.velocity();
   157	  }
   158	
   159	  std::cout << "GraphBuilder: " << N << " keyframes, " << graph->size()
   160	            << " factors (" << uwb_indices->size() << " UWB).\n";
   161	}
   162	
   163	}  // namespace uifgo
