     6	OutlierFilter::OutlierFilter(const Config& cfg) : cfg_(cfg) {}
     7	
     8	std::vector<UwbRange> OutlierFilter::PreFilter(const UwbFrame& frame) const {
     9	  std::vector<UwbRange> retained;
    10	  for (const auto& r : frame.ranges) {
    11	    // NLOS: rx_rssi - fp_rssi > threshold => multipath
    12	    if (r.rx_rssi - r.fp_rssi > cfg_.nlos_rssi_diff) continue;
    13	    // Range bounds
    14	    if (r.dist < cfg_.min_range || r.dist > cfg_.max_range) continue;
    15	    retained.push_back(r);
    16	  }
    17	  return retained;
    18	}
    19	
    20	bool OutlierFilter::ConsistencyCheck(const UwbRange& range,
    21	                                      const gtsam::Point3& tag_pred_world,
    22	                                      const gtsam::Point3& anchor_pos,
    23	                                      bool warmed_up) const {
    24	  if (!warmed_up) return true;
    25	  double predicted = (gtsam::Vector3(tag_pred_world) - gtsam::Vector3(anchor_pos)).norm();
    26	  return std::abs(predicted - range.dist) <= cfg_.dist_consistency_thresh;
    27	}
