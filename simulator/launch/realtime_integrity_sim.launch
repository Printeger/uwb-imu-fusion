<launch>
  <arg name="trajectory" default="figure_eight"/>
  <arg name="fault_mode" default="none"/>
  <arg name="fault_anchor_id" default="1"/>
  <arg name="fault_magnitude_m" default="1.0"/>
  <arg name="random_seed" default="20260901"/>
  <arg name="rviz" default="false"/>

  <node pkg="tf" type="static_transform_publisher" name="world_broadcaster"
        args="0 0 0 0 0 0 world map 100"/>

  <node pkg="uwb_imu_fgo" type="quadrotor_simulator_so3"
        name="quadrotor_simulator_so3" output="screen">
    <param name="rate/odom" value="200.0"/>
    <param name="simulator/init_state_x" value="0.0"/>
    <param name="simulator/init_state_y" value="0.0"/>
    <param name="simulator/init_state_z" value="0.0"/>
    <remap from="~odom" to="/sim/odom"/>
    <remap from="~cmd" to="/so3_cmd"/>
    <remap from="~imu" to="/sim/imu"/>
  </node>

  <node pkg="nodelet" type="nodelet"
        args="standalone so3_control/SO3ControlNodelet"
        name="so3_control" required="true" output="screen">
    <param name="so3_control/init_state_x" value="0.0"/>
    <param name="so3_control/init_state_y" value="0.0"/>
    <param name="so3_control/init_state_z" value="0.0"/>
    <remap from="~odom" to="/sim/odom"/>
    <remap from="~position_cmd" to="/position_cmd"/>
    <remap from="~motors" to="motors"/>
    <remap from="~corrections" to="corrections"/>
    <remap from="~so3_cmd" to="/so3_cmd"/>
    <remap from="~imu" to="/sim/imu"/>
    <rosparam file="$(find uwb_imu_fgo)/simulator/so3_control/gains.yaml"/>
    <rosparam file="$(find uwb_imu_fgo)/simulator/so3_control/corrections.yaml"/>
    <param name="mass" value="0.98"/>
    <param name="use_angle_corrections" value="false"/>
    <param name="use_external_yaw" value="false"/>
  </node>

  <node pkg="uwb_imu_fgo" type="trajectory_realtime.py"
        name="trajectory_generator" output="screen">
    <param name="trajectory" value="$(arg trajectory)"/>
    <param name="radius" value="3.0"/>
    <param name="period" value="20.0"/>
    <param name="height" value="2.0"/>
    <param name="rate" value="100.0"/>
  </node>

  <node pkg="uwb_imu_fgo" type="uwb_twr_sim"
        name="uwb_twr_sim" output="screen">
    <rosparam file="$(find uwb_imu_fgo)/simulator/config/uwb_twr_sim.yaml"/>
    <param name="odom_topic" value="/sim/odom"/>
    <param name="fault_mode" value="$(arg fault_mode)"/>
    <param name="fault_anchor_id" value="$(arg fault_anchor_id)"/>
    <param name="fault_magnitude_m" value="$(arg fault_magnitude_m)"/>
    <param name="random_seed" value="$(arg random_seed)"/>
  </node>

  <node pkg="uwb_imu_fgo" type="uwb_imu_pl_realtime_node"
        name="uwb_imu_pl_realtime" output="screen">
    <param name="config_path"
           value="$(find uwb_imu_fgo)/config/realtime_uwb_imu_pl_research.yaml"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find uwb_imu_fgo)/simulator/launch/sim_rviz.rviz"/>
</launch>
