<launch>
  <arg name="trajectory" default="figure_eight"/>
  <arg name="fault_mode" default="none"/>
  <arg name="fault_anchor_id" default="1"/>
  <arg name="fault_magnitude_m" default="1.0"/>
  <arg name="random_seed" default="20260901"/>
  <arg name="rviz" default="false"/>
  <arg name="run_directory" default=""/>
  <arg name="config_path"
       default="$(find uwb_imu_pl)/config/realtime_uwb_imu_pl_research.yaml"/>
  <arg name="fixed_lag_epochs" default=""/>
  <arg name="packet_loss_prob" default="0.0"/>
  <arg name="nlos_probability" default="0.0"/>
  <arg name="execution_command"
       default="roslaunch uwb_imu_pl realtime_integrity_stack.launch trajectory:=$(arg trajectory) fault_mode:=$(arg fault_mode) fault_anchor_id:=$(arg fault_anchor_id) fault_magnitude_m:=$(arg fault_magnitude_m) random_seed:=$(arg random_seed) rviz:=$(arg rviz) run_directory:=$(arg run_directory) config_path:=$(arg config_path) fixed_lag_epochs:=$(arg fixed_lag_epochs) packet_loss_prob:=$(arg packet_loss_prob) nlos_probability:=$(arg nlos_probability)"/>

  <node pkg="tf" type="static_transform_publisher" name="world_broadcaster"
        args="0 0 0 0 0 0 world map 100"/>

  <node pkg="uwb_imu_pl" type="quadrotor_simulator_so3"
        name="quadrotor_simulator_so3" output="screen">
    <param name="rate/odom" value="200.0"/>
    <param name="simulator/init_state_x" value="0.0"/>
    <param name="simulator/init_state_y" value="0.0"/>
    <param name="simulator/init_state_z" value="0.0"/>
    <remap from="~odom" to="/sim/odom"/>
    <remap from="~cmd" to="/so3_cmd"/>
    <remap from="~imu" to="/sim/imu"/>
  </node>

  <node pkg="nodelet" type="nodelet"
        args="standalone so3_control/SO3ControlNodelet"
        name="so3_control" required="true" output="screen">
    <param name="so3_control/init_state_x" value="0.0"/>
    <param name="so3_control/init_state_y" value="0.0"/>
    <param name="so3_control/init_state_z" value="0.0"/>
    <remap from="~odom" to="/sim/odom"/>
    <remap from="~position_cmd" to="/position_cmd"/>
    <remap from="~motors" to="motors"/>
    <remap from="~corrections" to="corrections"/>
    <remap from="~so3_cmd" to="/so3_cmd"/>
    <remap from="~imu" to="/sim/imu"/>
    <rosparam file="$(find uwb_imu_pl)/simulator/so3_control/gains.yaml"/>
    <rosparam file="$(find uwb_imu_pl)/simulator/so3_control/corrections.yaml"/>
    <param name="mass" value="0.98"/>
    <param name="use_angle_corrections" value="false"/>
    <param name="use_external_yaw" value="false"/>
  </node>

  <node pkg="uwb_imu_pl" type="trajectory_realtime.py"
        name="trajectory_generator" output="screen">
    <param name="trajectory" value="$(arg trajectory)"/>
    <param name="radius" value="3.0"/>
    <param name="period" value="20.0"/>
    <param name="height" value="2.0"/>
    <param name="rate" value="100.0"/>
  </node>

  <node pkg="uwb_imu_pl" type="uwb_twr_sim"
        name="uwb_twr_sim" output="screen">
    <rosparam file="$(find uwb_imu_pl)/simulator/config/uwb_twr_sim.yaml"/>
    <param name="odom_topic" value="/sim/odom"/>
    <param name="fault_mode" value="$(arg fault_mode)"/>
    <param name="fault_anchor_id" value="$(arg fault_anchor_id)"/>
    <param name="fault_magnitude_m" value="$(arg fault_magnitude_m)"/>
    <param name="random_seed" value="$(arg random_seed)"/>
    <param name="packet_loss_prob" value="$(arg packet_loss_prob)"/>
    <param name="nlos_probability" value="$(arg nlos_probability)"/>
  </node>

  <node pkg="uwb_imu_pl" type="uwb_imu_pl_realtime_node"
        name="uwb_imu_pl_realtime" output="screen">
    <param name="config_path"
           value="$(arg config_path)"/>
    <param name="fixed_lag_epochs" type="str"
           value="$(arg fixed_lag_epochs)"/>
    <param name="run_directory" value="$(arg run_directory)"/>
    <param name="execution_command" value="$(arg execution_command)"/>
    <remap from="/imu/data" to="/sim/imu"/>
  </node>

  <node if="$(arg rviz)" pkg="uwb_imu_pl" type="realtime_integrity_viz.py"
        name="realtime_integrity_viz" output="screen">
    <param name="world_frame" value="world"/>
    <param name="path_sample_period_s" value="0.05"/>
    <param name="path_publish_period_s" value="0.2"/>
    <param name="path_history_s" value="120.0"/>
    <param name="max_path_points" value="2402"/>
    <param name="ground_truth_buffer_s" value="120.0"/>
    <param name="max_pending_messages" value="2000"/>
    <param name="max_drawable_pl_m" value="50.0"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find uwb_imu_pl)/simulator/launch/sim_rviz.rviz"
        launch-prefix="env LIBGL_ALWAYS_SOFTWARE=1"/>
</launch>
