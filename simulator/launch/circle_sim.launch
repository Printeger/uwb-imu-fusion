<launch>
  <!-- ============================================================
       Quadrotor Simulation — Takeoff + Circle Trajectory
       Drone starts at origin, takes off to 2m, flies 3m-radius circle
       ============================================================ -->

  <!-- Simulation parameters -->
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="0.0"/>
  <arg name="rviz" default="true"/>

  <!-- ============ 0. Static TF: ensure "world" frame exists at startup ============ -->
  <node pkg="tf" type="static_transform_publisher"
        name="world_broadcaster"
        args="0 0 0 0 0 0 world map 100"/>

  <!-- ============ 1. Quadrotor Dynamics Simulator ============ -->
  <node pkg="uwb_imu_pl"
        type="quadrotor_simulator_so3"
        name="quadrotor_simulator_so3"
        output="screen">
    <param name="rate/odom" value="200.0"/>
    <param name="simulator/init_state_x" value="$(arg init_x)"/>
    <param name="simulator/init_state_y" value="$(arg init_y)"/>
    <param name="simulator/init_state_z" value="$(arg init_z)"/>
    <remap from="~odom" to="/sim/odom"/>
    <remap from="~cmd" to="/so3_cmd"/>
    <remap from="~imu" to="/sim/imu"/>
  </node>

  <!-- ============ 2. SO(3) Geometric Controller ============ -->
  <node pkg="nodelet"
        type="nodelet"
        args="standalone so3_control/SO3ControlNodelet"
        name="so3_control"
        required="true"
        output="screen">
    <param name="so3_control/init_state_x" value="$(arg init_x)"/>
    <param name="so3_control/init_state_y" value="$(arg init_y)"/>
    <param name="so3_control/init_state_z" value="$(arg init_z)"/>
    <remap from="~odom" to="/sim/odom"/>
    <remap from="~position_cmd" to="/position_cmd"/>
    <remap from="~motors" to="motors"/>
    <remap from="~corrections" to="corrections"/>
    <remap from="~so3_cmd" to="/so3_cmd"/>
    <remap from="~imu" to="/sim/imu"/>
    <rosparam file="$(find uwb_imu_pl)/simulator/so3_control/gains.yaml"/>
    <rosparam file="$(find uwb_imu_pl)/simulator/so3_control/corrections.yaml"/>
    <param name="mass" value="0.98"/>
    <param name="use_angle_corrections" value="false"/>
    <param name="use_external_yaw" value="false"/>
    <param name="gains/rot/z" value="1.0"/>
    <param name="gains/ang/z" value="0.1"/>
  </node>

  <!-- ============ 3. Trajectory Generator ============ -->
  <node pkg="uwb_imu_pl"
        type="trajectory_circle.py"
        name="trajectory_generator"
        output="screen">
    <param name="takeoff_height" value="2.0"/>
    <param name="takeoff_duration" value="3.0"/>
    <param name="hold_duration" value="2.0"/>
    <param name="circle_radius" value="3.0"/>
    <param name="circle_period" value="20.0"/>
    <param name="num_circles" value="3"/>
    <param name="return_duration" value="5.0"/>
    <param name="land_duration" value="3.0"/>
    <param name="rate" value="100"/>
  </node>

  <!-- ============ 4. UWB TWR Simulator ============ -->
  <node pkg="uwb_imu_pl"
        type="uwb_twr_sim"
        name="uwb_twr_sim"
        output="screen">
    <rosparam file="$(find uwb_imu_pl)/simulator/config/uwb_twr_sim.yaml"/>
    <param name="odom_topic" value="/sim/odom"/>
  </node>

  <!-- ============ 5. Odometry → Path Converter ============ -->
  <node pkg="uwb_imu_pl"
        type="odom_to_path.py"
        name="odom_to_path"
        output="screen"/>

  <!-- ============ 5. RViz Visualization ============ -->
  <node if="$(arg rviz)"
        pkg="rviz" type="rviz" name="rviz"
        args="-d $(find uwb_imu_pl)/simulator/launch/sim_rviz.rviz"
        launch-prefix="env LIBGL_ALWAYS_SOFTWARE=1 DISABLE_ROS1_EOL_WARNINGS=1"/>

</launch>
