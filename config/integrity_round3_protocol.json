    "test": {"begin": 5000000, "count": 1000000},
    "stress": {"begin": 7000000, "count": 1000000}
  },
  "sample_counts": {
    "pilot_per_cell": 16,
    "test_per_cell": 256,
    "gate_g_calibration": 1024,
