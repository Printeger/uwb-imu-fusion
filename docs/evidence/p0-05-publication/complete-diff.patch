+  value.imu.accelerometer_bias_rw_sigma = 0.001;
+  value.imu.gyroscope_bias_rw_sigma = 0.0001;
+  value.imu.gravity_mps2 = 9.80665;
+  value.realtime.world_frame = "map";
+  value.realtime.body_frame = "base_link";
+  return value;
+}
