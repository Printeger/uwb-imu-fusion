+  IntegrityOutput by_value;
+  by_value.transaction_id = 0x55;
+  by_value.publication.certificate_id = 0x22;
+  if (p005AbiIntegrityOutputByValue(by_value) != (0x55 ^ (0x22 << 1U)))
+    return 7;
+  IntegrityOutput values[2];
