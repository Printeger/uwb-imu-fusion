+      RiskBudgetV2{}, nullptr, &serial_arena);
+  ASSERT_TRUE(serial.model_valid) << serial.reason;
+
+  struct Digest {
+    std::vector<ProtectionLevelV2Result> results;
+    std::vector<std::uint64_t> proof_ids;
+    std::vector<std::vector<bool>> monitored;
+  };
