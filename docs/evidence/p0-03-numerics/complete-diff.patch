+  ASSERT_NE(legacy, nullptr);
+  const Eigen::MatrixXd z = Eigen::MatrixXd::Identity(2, 2);
+  const Eigen::MatrixXd g = Eigen::MatrixXd::Zero(3, 2);
+  int rank = 0;
+  EXPECT_EQ(legacy(z, g, 1e-10, nullptr, nullptr, &rank, nullptr, nullptr),
