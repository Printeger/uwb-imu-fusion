+      window, scoped_candidate, detector_risk);
+  ASSERT_TRUE(detector.passed) << detector.reason;
+  Eigen::MatrixXd mode = Eigen::MatrixXd::Zero(scoped_candidate.rows, 1);
+  mode(0, 0) = 1.0;
+  mode(mode.rows() - 1, 0) = 1.0;
