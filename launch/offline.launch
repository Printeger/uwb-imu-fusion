<launch>
  <!-- UWB-IMU FGO Offline Batch Processing -->
  <!-- 使用: roslaunch uwb_imu_pl offline.launch -->
  <!-- 自定义配置: roslaunch uwb_imu_pl offline.launch config_path:=/path/to/slam.yaml -->

  <arg name="config_path" default="$(find uwb_imu_pl)/config/sim_circle.yaml" />

  <env name="PYTHONUNBUFFERED" value="1" />

  <node pkg="uwb_imu_pl" type="uwb_imu_pl_node" name="uwb_imu_pl" output="screen"
        launch-prefix="stdbuf -oL">
    <param name="config_path" value="$(arg config_path)" />
  </node>

</launch>
