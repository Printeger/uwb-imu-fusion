#include <rosbag/bag.h>
#include <rosbag/view.h>
#include <fstream>
#include <iomanip>
#include <chrono>
#include <ctime>
#include <cstdlib>
#include <std_msgs/Float64MultiArray.h>
@UPSTREAM_INCLUDES@
#define private public
#define SplineFusion Sc8Reference
#define main sc8_reference_main_unused
#include "@ORIGINAL@"
#undef main
#undef SplineFusion
#define SplineFusion Sc8Observed
#define main sc8_observed_main_unused
#include "@OBSERVED@"
#undef main
#undef SplineFusion
#undef private

int main(int argc,char** argv){
 try {
  if(argc!=2)throw std::runtime_error("observer_checks INPUT_BAG");
  ros::init(argc,argv,"sc8_observer_checks");
  ros::NodeHandle nh("/SplineFusion");
  Sc8Reference reference(nh);Sc8Observed observed(nh);
  rosbag::Bag bag(argv[1],rosbag::bagmode::Read);rosbag::View view(bag);
  size_t events=0,checks=0;bool have_imu=false,toa64=false;
  for(const auto* connection:view.getConnections())if(connection->topic=="/EstimationInterface/toa_ds64")toa64=true;
  auto require=[&](bool condition){if(!condition)throw std::runtime_error("SFUISE_OBSERVER_NUMERICAL_MISMATCH event="+std::to_string(events));};
  for(const auto& item:view){
   if(auto m=item.instantiate<sensor_msgs::Imu>()){reference.getImuCallback(m);observed.getImuCallback(m);have_imu=true;}
   else if(auto m=item.instantiate<isas_msgs::RTLSStick>()){
    if(toa64)continue;
    reference.getToaCallback(m);observed.getToaCallback(m);
   }
   else if(auto m=item.instantiate<std_msgs::Float64MultiArray>()){
    // The pinned reference math already consumes double TOAData internally.
    // Feed that same physical sequence directly, bypassing only its float32 wire.
    const auto stamp=static_cast<int64_t>(m->data.at(0));
    const auto n=static_cast<size_t>(m->data.at(1));
    for(size_t i=0;i<n;++i)if(m->data.at(4+3*i)!=0)
      reference.toa_buff.emplace_back(stamp,static_cast<uint16_t>(m->data.at(2+3*i)),m->data.at(3+3*i));
    observed.getSc8Toa64Callback(m);
   }
   else if(auto m=item.instantiate<isas_msgs::Anchorlist>()){reference.getAnchorCallback(m);observed.getAnchorCallback(m);}
   else continue;
   reference.run();observed.run();++events;
   // Upstream SplineState has no initialized scalar knot count until init().
   if(!have_imu || !reference.if_anchor_ini)continue;
   require(reference.spline_local.numKnots()==observed.spline_local.numKnots());
   require(reference.window_count==observed.window_count);
   require(reference.imu_buff.size()==observed.imu_buff.size());
   require(reference.toa_buff.size()==observed.toa_buff.size());
   if(reference.spline_local.numKnots()>=2)require(reference.param.if_reject_uwb_in_optimization==observed.param.if_reject_uwb_in_optimization);
   if(reference.spline_local.numKnots())require(reference.calib_param.q_nav_uwb.coeffs()==observed.calib_param.q_nav_uwb.coeffs());
   if(reference.spline_local.numKnots())require(reference.calib_param.t_nav_uwb==observed.calib_param.t_nav_uwb);
   if(reference.spline_local.numKnots())require(reference.calib_param.gravity==observed.calib_param.gravity);
   for(size_t k=0;k<reference.spline_local.numKnots();++k){
    require(reference.spline_local.getKnotPos(k)==observed.spline_local.getKnotPos(k));
    require(reference.spline_local.getKnotOrt(k).coeffs()==observed.spline_local.getKnotOrt(k).coeffs());
    require(reference.spline_local.getKnotBias(k)==observed.spline_local.getKnotBias(k));++checks;
   }
  }
  require(events>100 && checks>100);
  std::cout<<"SC8_OBSERVER_EXACT_NUMERICAL_EQUALITY events="<<events<<" knots_checked="<<checks
           <<" final_window_count="<<reference.window_count<<std::endl;
  return 0;
 }catch(const std::exception& e){std::cerr<<e.what()<<std::endl;return 1;}
}
